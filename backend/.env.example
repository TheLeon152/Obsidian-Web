# ============================================================
# Obsidian Web - Backend Configuration
# ============================================================

# Path to the Obsidian vault
VAULT_PATH=C:/Users/Path/to/Your/Vault

# Google Calendar ICS URL
GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/ical/example%40gmail.com/private-.../basic.ics

# Folder used for notes created through the Inbox
INBOX_FOLDER=00_Inbox

# Folder containing task notes
TASKS_FOLDER=10_Tasks

# Allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]